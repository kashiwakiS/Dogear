    "Document Position merges same-page entries at the same level, then keeps colliding rows at least 6 points apart. Later rows flow downward instead of being redistributed across the rail." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“文档位置”会合并同页同层级的条目，并让发生碰撞的条目至少间隔 6 点。后续条目向下顺排，不会按导航条整体高度重新分布。"
          }
        }
      }
    },
